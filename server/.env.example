# ── Server ────────────────────────────────────────────────────────────────────
PORT=8747

# ── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB
DATABASE_URL=mongodb://localhost:27017/syncronus

# MongoDB Atlas (uncomment and replace if using Atlas)
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/syncronus

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_KEY=your_super_secret_jwt_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of your frontend — no trailing slash
ORIGIN=http://localhost:5173

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Redis
REDIS_URL=redis://localhost:6379

# Upstash Redis (uncomment if using Upstash)
# REDIS_URL=rediss://:your_password@your-instance.upstash.io:6379
